---
/* Dev-only: the live front page, for a line that has no pages yet (MULTI-LINE-PLAN.md, step 7). Routed only by `astro dev` (astro.config.mjs). */
import FrontPage from '../pages/index.astro';
import { lines, type LineId } from '../lib/data';

export function getStaticPaths() {
  return lines.map((l) => ({ params: { line: l.id } }));
}
---

<FrontPage lineId={Astro.params.line as LineId} />
