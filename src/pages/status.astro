---
/**
 * A line's status, answered: the questions people search for, each answered from the data files
 * with its grade and source (src/lib/answers.ts). The same answers feed the FAQPage structured data.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Colophon from '../components/Colophon.astro';
import Grade from '../components/Grade.astro';
import { getLine, formatDate, lineBase, type LineId } from '../lib/data';
import { answersFor } from '../lib/answers';
import '../styles/inner.css';

interface Props {
  /** Set by the `astro dev` preview (src/preview/status.astro); the live page is Line 12's. */
  lineId?: LineId;
}
const line = getLine(Astro.props.lineId ?? 'line-12');
const { lastReviewed } = line;
const { copy, label } = line.info;
const base = lineBase(line.id)!;
const answers = answersFor(line)!;
const site = Astro.site!.toString();

const title = copy.status_title;
const description = copy.status_description.replace('{checked}', formatDate(lastReviewed));

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Line 12 Tracker', item: site },
      { '@type': 'ListItem', position: 2, name: 'Status', item: `${site}${base.slice(1)}status/` },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: answers.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })),
  },
];
---

<Base title={title} description={description} schema={schema} line={line}>
  <Masthead line={line} home={false} />
  <main id="main" class="page inner">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={base}>{label}</a></li>
        <li aria-current="page">Status</li>
      </ol>
    </nav>

    <header class="inner__head">
      <h1 class="inner__title">{copy.status_h1}</h1>
      <p class="inner__mr mr" lang="mr">{copy.status_mr}</p>
      <p class="inner__standfirst">
        {copy.status_lead} Each answer shows how sure it is and where it comes from. Checked{' '}
        <time datetime={lastReviewed}>{formatDate(lastReviewed)}</time>.
      </p>
    </header>

    <dl class="facts">
      {answers.map((x) => (
        <div id={x.id}>
          <dt>{x.q}</dt>
          <dd>
            <p>{x.a}</p>
            <p class="grades">{x.grades.map((g) => <Grade status={g.status} source={g.source} />)}</p>
            {x.more && <p><a href={x.more.href}>{x.more.label}</a></p>}
          </dd>
        </div>
      ))}
    </dl>

    <p class="inner__block fact__note">
      <a href={base}>The full {label} tracker</a>, with the route, map, tenders and timeline.
    </p>
  </main>
  <Colophon line={line} />
</Base>
