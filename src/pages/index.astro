---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import FrontPage from '../components/FrontPage.astro';
import RouteRide from '../components/RouteRide.astro';
import MapSection from '../components/MapSection.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Numbers from '../components/Numbers.astro';
import Progress from '../components/Progress.astro';
import Timeline from '../components/Timeline.astro';
import Tenders from '../components/Tenders.astro';
import Trains from '../components/Trains.astro';
import Stations from '../components/Stations.astro';
import StationModel from '../components/StationModel.astro';
import Updates from '../components/Updates.astro';
import SourcesFooter from '../components/SourcesFooter.astro';
---

<Base
  title="Line 12 Tracker: Mumbai Metro Line 12, Kalyan to Taloja, unofficial"
  description="An unofficial, sourced tracker for Mumbai Metro Line 12 (Kalyan to Taloja): route, stations, progress, timeline, tenders and trains. Every figure links to its source."
>
  <Masthead />
  <main id="main">
    <FrontPage />
    <RouteRide />
    <MapSection />
    <BeforeAfter />
    <StationModel />
    <Numbers />
    <Progress />
    <Tenders />
    <Trains />
    <Stations />
    <Updates />
    <Timeline />
    <SourcesFooter />
  </main>
</Base>
