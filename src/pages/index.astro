---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import FrontPage from '../components/FrontPage.astro';
import RouteRide from '../components/RouteRide.astro';
import MapSection from '../components/MapSection.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Numbers from '../components/Numbers.astro';
import Progress from '../components/Progress.astro';
import Timeline from '../components/Timeline.astro';
import Tenders from '../components/Tenders.astro';
import Trains from '../components/Trains.astro';
import Stations from '../components/Stations.astro';
import StationModel from '../components/StationModel.astro';
import Updates from '../components/Updates.astro';
import SourcesFooter from '../components/SourcesFooter.astro';
import { getLine } from '../lib/data';

const line = getLine('line-12');
---

<Base
  title="Mumbai Metro Line 12 Tracker: Kalyan to Taloja status, stations, map"
  line={line}
  description="Unofficial, sourced tracker for Mumbai Metro Line 12, the Kalyan-Dombivli-Taloja metro: opening date, construction progress, all 19 stations, map, tenders and trains. Every figure links to its source."
>
  <Masthead line={line} />
  <main id="main">
    <FrontPage line={line} />
    <RouteRide line={line} />
    {line.alignmentRaw && <MapSection line={line} />}
    {line.beforeAfter && <BeforeAfter line={line} />}
    {line.stationModel && <StationModel line={line} />}
    <Numbers line={line} />
    <Progress line={line} />
    {line.tenders.length > 0 && <Tenders line={line} />}
    {line.rollingstock && <Trains line={line} />}
    <Stations line={line} />
    <Updates line={line} />
    {line.timeline.length > 0 && <Timeline line={line} />}
    <SourcesFooter line={line} />
  </main>
</Base>
