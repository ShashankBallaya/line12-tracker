---
/** All of a line's stations in order, each linking to its own page. */
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import Colophon from '../../components/Colophon.astro';
import Grade from '../../components/Grade.astro';
import { getLine } from '../../lib/data';
import '../../styles/inner.css';

const line = getLine('line-12');
const { stations, stationsMeta, project } = line;
const { label, route_short, about } = line.info;
const total = stations.length;
const site = Astro.site!.toString();
const title = `${about.name} Stations: all ${total}, ${route_short}`;
const description = `The ${total} stations of ${about.name} in order, from Kalyan through Dombivli MIDC and Nilje to Amandoot in Taloja, with interchanges and a page for each station.`;

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Line 12 Tracker', item: site },
      { '@type': 'ListItem', position: 2, name: 'Stations', item: `${site}stations/` },
    ],
  },
  {
    '@type': 'ItemList',
    name: `${about.name} stations, in order from ${stations[0].name}`,
    numberOfItems: total,
    itemListElement: stations.map((s) => ({ '@type': 'ListItem', position: s.order, name: `${s.name} (${s.name_mr})`, url: `${site}stations/${s.id}/` })),
  },
];
---

<Base title={title} description={description} schema={schema} line={line}>
  <Masthead line={line} home={false} />
  <main id="main" class="page inner">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">{label}</a></li>
        <li aria-current="page">Stations</li>
      </ol>
    </nav>

    <header class="inner__head">
      <h1 class="inner__title">{about.name} stations</h1>
      <p class="inner__mr mr" lang="mr">{line.info.mark_mr}: सर्व स्थानके</p>
      <p class="inner__standfirst">
        All {total}, in order from Kalyan to Amandoot in Taloja. Every station is elevated. The line is{' '}
        {project.length_km.value} km long.
      </p>
    </header>

    <ol class="stlist">
      {stations.map((s) => (
        <li class="stlist__row">
          <span class="stlist__order num">{String(s.order).padStart(2, '0')}</span>
          <span class="stlist__names">
            <a class="stlist__name" href={`/stations/${s.id}/`}>{s.name}</a>
            <span class="stlist__mr mr" lang="mr">{s.name_mr}</span>
          </span>
          <span class="stlist__meta">
            {s.interchanges.value.length > 0 ? `Interchange: ${s.interchanges.value.join(', ')}` : 'Elevated'}
          </span>
        </li>
      ))}
    </ol>

    <p class="inner__block fact__note">
      Station list and order <Grade status="reported" source={stationsMeta.order_source_url} />
      <span aria-hidden="true">,</span> station count <Grade status="verified" source={stationsMeta.count_source_url} />
    </p>
  </main>
  <Colophon line={line} />
</Base>

<style>
  .stlist {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule-heavy) solid var(--rule-strong);
  }
  .stlist__row {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 0 var(--s-3);
    align-items: baseline;
    padding-block: var(--s-3);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  @media (min-width: 48rem) {
    .stlist__row {
      grid-template-columns: 2.2rem minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .stlist__names {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s-3);
  }
  .stlist__mr {
    font-size: var(--step-1);
    color: var(--ink-2);
  }
  .stlist__order {
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .stlist__name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-2);
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .stlist__name:hover {
      text-decoration: underline;
      text-decoration-thickness: 3px;
      text-decoration-color: var(--signal-line);
    }
  }
  .stlist__meta {
    grid-column: 2;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  @media (min-width: 48rem) {
    .stlist__meta {
      grid-column: 3;
    }
  }
</style>
