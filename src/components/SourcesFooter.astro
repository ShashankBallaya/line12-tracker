---
import Grade from './Grade.astro';
import Colophon from './Colophon.astro';
import { correctionUrl, REPO_URL, gradeHelp, type Grade as G, type Line } from '../lib/data';

interface Props {
  line: Line;
}
const { line } = Astro.props;

// The documents most of the line's figures come from (lines.json `copy.primary_sources`).
const primary = line.info.copy.primary_sources;
const grades: G[] = ['verified', 'reported', 'unverified', 'conflicting'];
---

<section id="sources" class="section page" aria-labelledby="sources-title">
  <header class="section-head">
    <h2 id="sources-title">Sources and corrections</h2>
    <p>Every figure on this page links to where it came from. This is how to read the marks next to them.</p>
  </header>

  <div class="sources">
    <ul class="legend" aria-label="What the marks mean">
      {grades.map((g) => (
        <li><Grade status={g} noSource /> <span>{gradeHelp[g]}</span></li>
      ))}
    </ul>

    <div>
      <h3 class="sources__title">Primary sources</h3>
      <ul class="primary">
        {primary.map((s) => (
          <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a><span>{s.note}</span></li>
        ))}
      </ul>
      <p class="sources__more">
        The full list, with every news and trade source, is in{' '}
        <a href={`${REPO_URL}/blob/main/SOURCES.md`} rel="noopener" target="_blank">SOURCES.md</a>.
      </p>
    </div>

    <div class="correct">
      <h3 class="sources__title">Spotted a mistake?</h3>
      <p>Tell us what is wrong and where you saw the right figure. Corrections are public and dated.</p>
      <a class="correct__btn" data-magnetic href={correctionUrl(line)} rel="noopener" target="_blank">Report a correction on GitHub</a>
    </div>
  </div>
</section>

<Colophon line={line} />

<style>
  .sources {
    display: grid;
    gap: var(--s-6);
    border-top: var(--rule-heavy) solid var(--rule-strong);
    padding-top: var(--s-5);
  }
  @media (min-width: 64rem) {
    .sources {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-7);
    }
  }
  .legend,
  .primary {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .legend li {
    display: grid;
    gap: var(--s-1);
    color: var(--ink-2);
  }
  .primary li {
    display: grid;
    gap: var(--s-1);
  }
  .primary a {
    font-weight: 700;
  }
  .primary span,
  .sources__more {
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  .sources__more {
    margin-top: var(--s-4);
  }
  .sources__title {
    font-size: var(--step-2);
    text-transform: uppercase;
    margin-bottom: var(--s-4);
  }
  .correct p {
    color: var(--ink-2);
    margin-bottom: var(--s-5);
  }
  .correct__btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: var(--s-2) var(--s-5);
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out), translate 0.35s var(--ease-out), scale 0.16s var(--ease-out);
  }
  .correct__btn:active {
    scale: 0.97;
  }
  @media (hover: hover) and (pointer: fine) {
    .correct__btn:hover {
      background: var(--signal);
      color: var(--on-signal);
    }
  }

</style>
