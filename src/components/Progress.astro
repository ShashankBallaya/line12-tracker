---
import Grade from './Grade.astro';
import { formatDate, type Line } from '../lib/data';

interface Props {
  line: Line;
}
const { line } = Astro.props;
const { project, stages } = line;

const progress = project.progress;
/** A figure for the whole line from a news report, when there is one. */
const overall = (progress as { overall_reported?: typeof project.progress.overall_reported }).overall_reported;
const stateLabel = { done: 'Done', now: 'Now', started: 'Started', next: 'Not started' };
// A finished table (Line 5, Phase 1) says it once: one full bar and the list, not nine identical bars.
const allDone = progress.items.length > 1 && progress.items.every((i) => i.percent_complete >= 100);
---

<section id="progress" class="section page" aria-labelledby="progress-title">
  <header class="section-head">
    <h2 id="progress-title">Progress</h2>
    <p>{progress.summary}</p>
  </header>

  {stages.map((sec) => (
    <Fragment>
      {sec.label && <h3 class="phases__label">{sec.label}</h3>}
      <ol class:list={['phases', sec.label && 'phases--part']} aria-label={sec.label ?? 'Project phases'}>
        {sec.stages.map((ph) => (
          <li class:list={['phase', `phase--${ph.state}`]}>
            <span class="phase__bar" aria-hidden="true"></span>
            <span class="phase__name">{ph.name}</span>
            <span class="phase__state">{stateLabel[ph.state]}</span>
            <span class="phase__note">{ph.note}</span>
          </li>
        ))}
      </ol>
    </Fragment>
  ))}

  <div class="works">
    <h3 class="works__title">Civil works complete, as of <time datetime={progress.as_of}>{formatDate(progress.as_of)}</time></h3>
    {allDone ? (
      <div class="complete">
        <p class="complete__pct num">100<span class="work__unit">%</span></p>
        <p class="complete__text">Every activity in MMRDA's table, {progress.items.length} of {progress.items.length}:</p>
        <span class="work__track complete__track" role="meter" aria-label="All civil activities" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100">
          <span class="work__fill" style="--pct:100%" data-grow></span>
        </span>
        <ul class="complete__list">
          {progress.items.map((item) => <li>{item.activity}</li>)}
        </ul>
      </div>
    ) : (
    <ul class="works__list">
      {progress.items.map((item) => (
        <li class="work">
          <span class="work__name">{item.activity}</span>
          <span class="work__pct num"><span data-count={item.percent_complete} data-decimals="2">{item.percent_complete.toFixed(2)}</span><span class="work__unit">%</span></span>
          <span
            class="work__track"
            role="meter"
            aria-label={item.activity}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={item.percent_complete}
          >
            <span class="work__fill" style={`--pct:${item.percent_complete}%`} data-grow></span>
          </span>
        </li>
      ))}
    </ul>
    )}
    <p><Grade status={progress.status} source={progress.source_url} /></p>

    {overall && (
    <div class="overall">
      <p class="overall__pct num"><span data-count={overall.percent_complete} data-decimals="2">{overall.percent_complete.toFixed(2)}</span><span class="work__unit">%</span></p>
      <p class="overall__text">
        <strong>Whole line, as reported on <time datetime={overall.as_of}>{formatDate(overall.as_of)}</time>.</strong>{' '}
        Loksatta quotes unnamed MMRDA sources. MMRDA's table above gives no overall figure, and the report does not
        say how this one was measured, so do not compare it with the figures above.
      </p>
      <p><Grade status={overall.status} source={overall.source_url} /></p>
    </div>
    )}
  </div>
</section>

<style>
  .phases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: var(--s-4) var(--s-2);
    margin: 0 0 var(--s-7);
    padding: 0;
    list-style: none;
  }
  /* A line built in parts: one row of stages per part, each under its name. */
  .phases__label {
    margin: 0 0 var(--s-3);
    font-size: var(--step-0);
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
  }
  .phases--part {
    margin-bottom: var(--s-6);
    padding-bottom: var(--s-5);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .phase {
    display: grid;
    gap: var(--s-1);
    align-content: start;
  }
  .phase__bar {
    height: calc(var(--bar) * 2);
    margin-bottom: var(--s-2);
  }
  .phase--done .phase__bar {
    background: var(--ink);
  }
  .phase--now .phase__bar {
    background: var(--signal-graphic);
  }
  .phase--started .phase__bar {
    background: repeating-linear-gradient(to right, var(--signal-graphic) 0 12px, transparent 12px 18px);
  }
  .phase--next .phase__bar {
    border: 2px dashed var(--rule);
  }
  .phase__state {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }
  .phase--now .phase__state {
    color: var(--ink);
    font-weight: 700;
  }
  .phase__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-2);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .phase--next .phase__name {
    color: var(--ink-3);
  }
  .phase__note {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .works {
    display: grid;
    gap: var(--s-5);
    padding-top: var(--s-5);
    border-top: var(--rule-heavy) solid var(--rule-strong);
  }
  .works__title {
    font-size: var(--step-2);
    text-transform: uppercase;
  }
  .works__list {
    display: grid;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
  }
  .work__name {
    font-weight: 500;
    font-size: var(--step-1);
  }
  .work__pct {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-4);
    line-height: 0.9;
  }
  .work__unit {
    font-size: 0.5em;
    margin-left: 0.08em;
    color: var(--ink-2);
  }
  .work__track {
    grid-column: 1 / -1;
    display: block;
    height: calc(var(--bar) * 2);
    background: var(--paper-2);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .complete {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s-3) var(--s-5);
  }
  .complete__pct {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-4);
    line-height: 0.85;
  }
  .complete__text {
    font-weight: 500;
    font-size: var(--step-1);
  }
  .complete__track,
  .complete__list {
    grid-column: 1 / -1;
  }
  /* The activities as a ruled list, newspaper columns. */
  .complete__list {
    columns: 16rem auto;
    column-gap: var(--s-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .complete__list li {
    break-inside: avoid;
    padding-block: var(--s-2);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .overall {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s-2) var(--s-5);
    padding-top: var(--s-5);
    border-top: var(--rule-w) dashed var(--rule);
  }
  .overall__pct {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-4);
    line-height: 0.9;
  }
  .overall__text {
    color: var(--ink-2);
    max-width: 60ch;
  }
  .overall > p:last-child {
    grid-column: 1 / -1;
  }
  @media (max-width: 40rem) {
    .overall {
      grid-template-columns: 1fr;
    }
  }
  .work__fill {
    display: block;
    height: 100%;
    width: var(--pct);
    background: var(--signal-graphic);
    transform-origin: left center;
  }
</style>
