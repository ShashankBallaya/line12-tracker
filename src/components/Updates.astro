---
import Grade from './Grade.astro';
import { socialPosts, timeline, formatDate, outletName } from '../lib/data';

// Latest reports: dated, sourced milestones from the timeline, newest first.
const latest = timeline
  .filter((e) => e.date && e.source_url && e.kind !== 'future')
  .sort((a, b) => (b.date as string).localeCompare(a.date as string))
  .slice(0, 6);
---

<section id="updates" class="section page" aria-labelledby="updates-title">
  <header class="section-head">
    <h2 id="updates-title">Updates</h2>
    <p>The latest reported milestones, each linked to the article or document, and posts on X picked by hand.</p>
  </header>

  <div class="updates">
    <div class="updates__col">
      <h3 class="updates__title">Latest reports</h3>
      <ol class="reports">
        {latest.map((e) => (
          <li class="report">
            <p class="report__date num"><time datetime={e.date}>{formatDate(e.date)}</time></p>
            <a class="report__title" href={e.source_url} target="_blank" rel="noopener">{e.title}<span class="visually-hidden"> (opens in a new tab)</span></a>
            <p class="report__meta">{outletName(e.source_url)} <Grade status={e.status} compact noSource /></p>
          </li>
        ))}
      </ol>
      <p class="reports__more"><a href="#timeline">Every milestone is in the timeline</a></p>
    </div>
    <div class="updates__col">
      <h3 class="updates__title">On X</h3>
      {socialPosts.length === 0 ? (
        <div class="empty">
          <p class="empty__head">No posts picked yet.</p>
          <p>Posts appear here only after a person has checked them. They are shown with X's official embed.</p>
        </div>
      ) : (
        <ul class="posts">
          {socialPosts.map((p) => (
            <li><blockquote class="twitter-tweet" data-dnt="true"><a href={p.url}>View post on X</a></blockquote></li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .updates {
    display: grid;
    gap: var(--s-6);
    border-top: var(--rule-heavy) solid var(--rule-strong);
    padding-top: var(--s-5);
  }
  @media (min-width: 56rem) {
    .updates {
      grid-template-columns: 1.5fr 1fr;
      gap: var(--s-7);
    }
  }
  .updates__title {
    font-size: var(--step-2);
    text-transform: uppercase;
    margin-bottom: var(--s-4);
  }
  .reports {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule-w) solid var(--rule);
  }
  .report {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-3);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .report__date {
    grid-row: span 2;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-1);
    line-height: 1.1;
  }
  .report__title {
    font-weight: 700;
    text-decoration-color: transparent;
  }
  .report__title:hover {
    text-decoration-color: var(--signal-line);
  }
  .report__meta {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .reports__more {
    margin-top: var(--s-3);
    font-size: var(--step--1);
  }
  .empty {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-5);
    border: 2px dashed var(--rule);
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .empty__head {
    font-weight: 700;
    color: var(--ink);
    font-size: var(--step-1);
  }
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
