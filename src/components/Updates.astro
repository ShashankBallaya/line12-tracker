---
import Grade from './Grade.astro';
import { socialPosts, timeline, feed, formatDate, outletName } from '../lib/data';

// Latest reports: dated, sourced milestones from the timeline, newest first.
const latest = timeline
  .filter((e) => e.date && e.source_url && e.kind !== 'future')
  .sort((a, b) => (b.date as string).localeCompare(a.date as string))
  .slice(0, 6);

// The automatic feed: the ten newest headlines the timeline does not already link to,
// and videos only once the feed has found some.
const bare = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const curated = new Set(timeline.map((e) => e.source_url && bare(e.source_url)).filter(Boolean));
const news = feed.news.filter((n) => !curated.has(bare(n.url))).slice(0, 10);
const videos = feed.videos.slice(0, 6);
const feedUpdated = feed._meta.updated_at.slice(0, 10);
---

<section id="updates" class="section page" aria-labelledby="updates-title">
  <header class="section-head">
    <h2 id="updates-title">Updates</h2>
    <p>
      The latest reported milestones, each linked to the article or document, posts on X picked by hand, and news
      that a script finds every six hours.
    </p>
  </header>

  <div class="updates">
    <div class="updates__col">
      <h3 class="updates__title">Latest reports</h3>
      <ol class="reports">
        {latest.map((e) => (
          <li class="report">
            <p class="report__date num"><time datetime={e.date}>{formatDate(e.date)}</time></p>
            <a class="report__title" href={e.source_url} target="_blank" rel="noopener">{e.title}<span class="visually-hidden"> (opens in a new tab)</span></a>
            <p class="report__meta">{outletName(e.source_url)} <Grade status={e.status} compact noSource /></p>
          </li>
        ))}
      </ol>
      <p class="reports__more"><a href="#timeline">Every milestone is in the timeline</a></p>
    </div>
    <div class="updates__col">
      <h3 class="updates__title">On X</h3>
      {socialPosts.length === 0 ? (
        <div class="empty">
          <p class="empty__head">No posts picked yet.</p>
          <p>Posts appear here only after a person has checked them.</p>
        </div>
      ) : (
        <>
          <p class="posts__note">Posts by people who follow the project, not by MMRDA. Their claims count as reported.</p>
          {/* A ruled list like the reports. X's script loads only when a reader asks for one full post. */}
          <ol class="posts">
            {socialPosts.map((p) => {
              const id = p.url.split('/status/')[1].split(/[?/]/)[0];
              return (
                <li class="post">
                  <p class="post__date num"><time datetime={p.date}>{formatDate(p.date)}</time></p>
                  <div class="post__body">
                    <p class="post__by">{p.author} <span class="post__handle">@{p.handle}</span></p>
                    <p class="post__text">{p.text}</p>
                    <p class="post__meta">
                      <Grade status={p.status} compact noSource />
                      <a href={p.url} target="_blank" rel="noopener">Open on X<span class="visually-hidden"> (opens in a new tab)</span></a>
                      <button class="post__more" type="button" aria-expanded="false" aria-controls={`xpost-${id}`} data-x-show={id}>
                        <span data-x-label>Show full post</span>
                      </button>
                    </p>
                    <div class="post__embed" id={`xpost-${id}`} hidden aria-live="polite"></div>
                  </div>
                </li>
              );
            })}
          </ol>
        </>
      )}
    </div>
  </div>

  <div class="updates updates--feed">
    <div class="updates__col">
      <h3 class="updates__title">In the news</h3>
      <p class="posts__note">
        Found automatically in the outlets' own feeds, not checked by a person. Last new item found{' '}
        <time datetime={feedUpdated}>{formatDate(feedUpdated)}</time>.
      </p>
      {news.length === 0 ? (
        <div class="empty">
          <p class="empty__head">Nothing found yet.</p>
          <p>Headlines about Line 12 appear here when an outlet publishes one.</p>
        </div>
      ) : (
        <ol class="reports">
          {news.map((n) => (
            <li class="report">
              <p class="report__date num"><time datetime={n.date}>{formatDate(n.date)}</time></p>
              <a class="report__title" href={n.url} target="_blank" rel="noopener">{n.title}<span class="visually-hidden"> (opens in a new tab)</span></a>
              <p class="report__meta">{n.outlet}</p>
            </li>
          ))}
        </ol>
      )}
    </div>
    {videos.length > 0 && (
      <div class="updates__col">
        <h3 class="updates__title">Videos</h3>
        <p class="posts__note">Found automatically on YouTube, not checked by a person.</p>
        <ol class="videos">
          {videos.map((v) => (
            <li class="video">
              <a class="video__link" href={v.url} target="_blank" rel="noopener">
                <img class="video__thumb" src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt="" width="320" height="180" loading="lazy" decoding="async" />
                <span class="video__title">{v.title}<span class="visually-hidden"> (video on YouTube, opens in a new tab)</span></span>
              </a>
              <p class="report__meta">{v.channel}, <time datetime={v.date}>{formatDate(v.date)}</time></p>
            </li>
          ))}
        </ol>
      </div>
    )}
  </div>
</section>

<style>
  .updates {
    display: grid;
    gap: var(--s-6);
    border-top: var(--rule-heavy) solid var(--rule-strong);
    padding-top: var(--s-5);
  }
  @media (min-width: 56rem) {
    .updates {
      grid-template-columns: 1.5fr 1fr;
      gap: var(--s-7);
    }
  }
  .updates--feed {
    margin-top: var(--s-7);
  }
  .videos {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule-w) solid var(--rule);
    padding-top: var(--s-3);
  }
  .video {
    display: grid;
    gap: var(--s-1);
  }
  .video__link {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--s-3);
    align-items: start;
    font-weight: 700;
    text-decoration-color: transparent;
  }
  @media (hover: hover) and (pointer: fine) {
    .video__link:hover {
      text-decoration-color: var(--signal-line);
    }
  }
  .video__thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--paper-2);
  }
  .video .report__meta {
    padding-left: calc(8rem + var(--s-3));
  }
  .updates__title {
    font-size: var(--step-2);
    text-transform: uppercase;
    margin-bottom: var(--s-4);
  }
  .reports {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule-w) solid var(--rule);
  }
  .report {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-3);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .report__date {
    grid-row: span 2;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-1);
    line-height: 1.1;
  }
  .report__title {
    font-weight: 700;
    text-decoration-color: transparent;
  }
  @media (hover: hover) and (pointer: fine) {
    .report__title:hover {
      text-decoration-color: var(--signal-line);
    }
  }
  .report__meta {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .reports__more {
    margin-top: var(--s-3);
    font-size: var(--step--1);
  }
  .empty {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-5);
    border: 2px dashed var(--rule);
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .empty__head {
    font-weight: 700;
    color: var(--ink);
    font-size: var(--step-1);
  }
  .posts__note {
    max-width: var(--measure);
    margin-bottom: var(--s-3);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  /* Same grammar as .reports: hairline rows, the date as a condensed figure on the left. */
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule-w) solid var(--rule);
  }
  .post {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-3);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .post__date {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-1);
    line-height: 1.1;
  }
  .post__body {
    display: grid;
    gap: var(--s-1);
    min-width: 0;
  }
  .post__by {
    font-weight: 700;
  }
  .post__handle {
    font-weight: 400;
    color: var(--ink-3);
  }
  .post__text {
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-3);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  /* A text control, not a box: it opens more of the row, it does not start a task. */
  .post__more {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 44px;
    padding: 0;
    font: inherit;
    font-weight: 500;
    color: var(--ink);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .post__more span {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--signal-line);
    transition: text-decoration-thickness 0.2s var(--ease-out);
  }
  .post__more::after {
    content: '';
    width: 0.42em;
    height: 0.42em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: 45deg;
    translate: 0 -0.12em;
    transition: rotate 0.2s var(--ease-out), translate 0.2s var(--ease-out);
  }
  .post__more[aria-expanded='true']::after {
    rotate: 225deg;
    translate: 0 0.12em;
  }
  .post__more[aria-busy='true'] {
    color: var(--ink-3);
    cursor: progress;
  }
  @media (hover: hover) and (pointer: fine) {
    .post__more:hover span {
      text-decoration-thickness: 3px;
    }
  }
  .post__embed {
    padding-top: var(--s-1);
  }
  .post__embed[hidden] {
    display: none;
  }
  .post__embed :global(.twitter-tweet-rendered),
  .post__embed :global(iframe) {
    max-width: 100% !important;
    margin: 0 !important;
  }
  .post__embed :global(.post__fail) {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  /* On a phone the date sits above the post like a dateline, so the text gets the full width. */
  @media (max-width: 30rem) {
    .post {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
