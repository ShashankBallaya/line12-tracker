---
import Grade from './Grade.astro';
import LeadPicture from './LeadPicture.astro';
import { project, stations, formatDate } from '../lib/data';
import { schematic } from '../lib/route';

const target = project.target_completion;
const progress = project.progress;
const pct = (name: string) => Math.round(progress.items.find((i) => i.activity.startsWith(name))!.percent_complete);

// Build-time value; the countdown script refreshes it in the browser.
const msPerDay = 86_400_000;
const daysLeft = Math.max(0, Math.ceil((Date.parse(`${target.countdown_date}T23:59:59+05:30`) - Date.now()) / msPerDay));
const earlier = target.alternatives[0];
const first = stations[0].name;
const last = stations[stations.length - 1].name;

// Schematic strip (shared geometry with the route ride).
const { width: W, height: H, path, points: dots } = schematic();
---

<section class="front page" aria-labelledby="front-headline">
  <div class="front__lead">
    <h1 id="front-headline" class="front__headline" data-split>
      Kalyan to Taloja,<br /> {project.length_km.value} km in the air.
    </h1>
    <p class="front__standfirst">
      Metro Line 12 will run fully elevated from Kalyan through Dombivli MIDC, Kalyan Growth Centre and Turbhe to
      Amandoot in Taloja, with {project.stations_count.value} stations. On {formatDate(progress.as_of)}, MMRDA put pile
      work at about {pct('Pile works')} per cent and U-girder erection at about {pct('U-girder')} per cent.
    </p>
    <p class="front__grade"><Grade status={progress.status} source={progress.source_url} /></p>
    <a class="front__ride" href="#route">
      Ride the line
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v15M5 12l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" /></svg>
    </a>
  </div>

  <aside class="front__countdown" aria-labelledby="countdown-title">
    <h2 id="countdown-title" class="front__countdown-title">Days to the reported target</h2>
    <p class="front__days num" data-countdown={target.countdown_date} aria-live="off">
      <span data-countdown-value>{daysLeft.toLocaleString('en-IN')}</span>
    </p>
    <p class="front__target">
      Target: <strong>{formatDate(target.value)}</strong>, as reported in December 2025. Earlier reported target:{' '}
      {formatDate(earlier.value)}. MMRDA's project page gives no date.
    </p>
    <p><Grade status={target.status} source={target.source_url} /></p>
  </aside>

  <div class="front__picture"><LeadPicture /></div>

  <a class="front__strip" href="#route" aria-label={`The route: ${stations.length} stations from ${first} to ${last}. Ride the line.`}>
    <span class="front__strip-end front__strip-end--a">{first}</span>
    <svg class="front__strip-line" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d={path} class="line-casing" vector-effect="non-scaling-stroke" />
      <path d={path} class="line-core" vector-effect="non-scaling-stroke" />
    </svg>
    <span class="front__strip-dots" aria-hidden="true">
      {dots.map(([x, y]) => <span class="front__strip-dot" style={`left:${(x / W) * 100}%;top:${(y / H) * 100}%`}></span>)}
    </span>
    <span class="front__strip-end front__strip-end--b">{last}</span>
    <span class="front__strip-meta num">{stations.length} stations<span aria-hidden="true"> / </span>{project.length_km.value} km</span>
  </a>
</section>

<style>
  .front {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
    padding-block: var(--s-7) var(--s-8);
  }
  @media (min-width: 64rem) {
    .front {
      grid-template-columns: minmax(0, 1.45fr) minmax(20rem, 1fr);
      grid-template-areas:
        'lead pic'
        'lead count'
        'strip strip';
      column-gap: var(--s-7);
      row-gap: var(--s-5);
      padding-block: var(--s-6) var(--s-7);
    }
    .front__lead { grid-area: lead; }
    .front__countdown { grid-area: count; }
    .front__picture { grid-area: pic; align-self: start; }
    .front__strip { grid-area: strip; }
    .front__countdown {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--s-5);
      align-items: end;
    }
    .front__countdown-title,
    .front__countdown > p:last-child {
      grid-column: 1 / -1;
    }
  }
  .front__lead {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }
  .front__headline {
    font-size: var(--step-4);
    text-transform: uppercase;
    line-height: 0.88;
  }
  .front__standfirst {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .front__ride {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 48px;
    padding: var(--s-2) var(--s-5);
    background: var(--signal);
    color: var(--on-signal);
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-1);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: transform 0.3s var(--ease-out), background-color 0.2s;
  }
  .front__ride svg {
    width: 1.3em;
    height: 1.3em;
    transition: transform 0.3s var(--ease-out);
  }
  .front__ride:hover svg {
    transform: translateY(3px);
  }
  .front__ride:active {
    transform: scale(0.98);
  }
  .front__countdown {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-4);
    border-top: var(--rule-heavy) solid var(--rule-strong);
  }
  .front__countdown-title {
    font-size: var(--step-1);
    text-transform: uppercase;
  }
  .front__days {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-4);
    line-height: 0.85;
    color: var(--ink);
  }
  .front__target {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.45;
    max-width: 38ch;
  }
  /* The front-page infographic: the whole line in one strip, a door into the ride. */
  .front__strip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    padding-top: var(--s-4);
    border-top: var(--rule-heavy) solid var(--rule-strong);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: var(--step-1);
  }
  .front__strip-line,
  .front__strip-dots {
    grid-column: 2;
    grid-row: 1;
    width: 100%;
    height: 4.5rem;
  }
  .front__strip-dots {
    position: relative;
  }
  .front__strip-line .line-casing,
  .front__strip-line .line-core {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .front__strip-line .line-casing {
    stroke: var(--signal-graphic);
    stroke-width: 14px;
  }
  .front__strip-line .line-core {
    stroke: var(--paper);
    stroke-width: 5px;
  }
  .front__strip-dot {
    position: absolute;
    width: 0.85rem;
    height: 0.85rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--ink);
    border: 2.5px solid var(--paper);
    transition: scale 0.3s var(--ease-out);
  }
  .front__strip:hover .front__strip-dot {
    scale: 1.2;
  }
  .front__strip-end--a {
    grid-area: 1 / 1;
    align-self: start;
  }
  .front__strip-end--b {
    grid-area: 1 / 3;
    align-self: end;
  }
  .front__strip-meta {
    grid-column: 1 / -1;
    justify-self: end;
    font-family: var(--font-body);
    font-weight: 500;
    font-stretch: 100%;
    text-transform: none;
    font-size: var(--step--1);
    color: var(--ink-3);
  }
</style>
