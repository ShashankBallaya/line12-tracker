---
import Grade from './Grade.astro';
import LineMark from './LineMark.astro';
import { lineCopy, stationHref, getLine, plannedInterchanges, type Line, type LineId, type Station } from '../lib/data';

interface Props {
  line: Line;
}
const { line } = Astro.props;
const { stations, spurStations, droppedStations, stationsMeta } = line;
const page = (s: Station) => stationHref(line.id, s.id);
type SameSite = { line: LineId; station: string };
/** What the revised plan of 2026 says about a station (Line 5). */
const plan = (s: Station) => (s as { revised_plan_2026?: { value: string; status: string; source_url: string } }).revised_plan_2026;
/** A station of another line at the same place: its name, and a link when that line has pages. */
const sameSite = (s: Station) => {
  const other = (s as { same_site_as?: SameSite }).same_site_as;
  if (!other) return null;
  const o = getLine(other.line);
  return { line: other.line, label: `${o.info.label} ${o.stations.find((x) => x.id === other.station)?.name ?? other.station}`, href: stationHref(other.line, other.station) };
};

---

<section id="stations" class="section page" aria-labelledby="stations-title">
  <header class="section-head">
    <h2 id="stations-title">Stations</h2>
    <p>{lineCopy(line, 'stations_section')}</p>
  </header>

  <ol class="directory">
    {stations.map((s) => (
      <li class="entry">
        <a class="entry__link" href={`#station-${s.id}`}>
          <span class="entry__order num">{String(s.order).padStart(2, '0')}</span>
          <span class="entry__name">{s.name}</span>
        </a>
        <span class="entry__mr mr" lang="mr">{s.name_mr}</span>
        {s.interchanges.value.length > 0 && <span class="entry__change">Interchange: {s.interchanges.value.map((v, k) => <>{k > 0 && ', '}<LineMark text={v} />{v}</>)}</span>}
        {sameSite(s) && (
          <span class="entry__change">
            Same site as <LineMark lineId={sameSite(s)!.line} />{sameSite(s)!.href ? <a href={sameSite(s)!.href}>{sameSite(s)!.label}</a> : sameSite(s)!.label}
          </span>
        )}
        {plannedInterchanges(s) && <span class="entry__change">Planned interchange: {plannedInterchanges(s)!.value.join(', ')}</span>}
        {s.type !== 'Elevated' && <span class="entry__change">{s.type}</span>}
        {s.location.lat === null && <span class="entry__change">Position not yet mapped</span>}
        {page(s) && <a class="entry__page" href={page(s)}>Station page<span class="visually-hidden">: {s.name}</span></a>}
      </li>
    ))}
  </ol>

  {spurStations.length > 0 && (
    <>
      <h3 class="directory__group">Line {spurStations[0].phase} spur, from {line.spurFrom?.name}</h3>
      <ol class="directory">
        {spurStations.map((s) => (
          <li class="entry">
            <a class="entry__link" href={`#station-${s.id}`}>
              <span class="entry__order num">{String(s.order).padStart(2, '0')}</span>
              <span class="entry__name">{s.name}</span>
            </a>
            {s.name_mr && <span class="entry__mr mr" lang="mr">{s.name_mr}</span>}
            {page(s) && <a class="entry__page" href={page(s)}>Station page<span class="visually-hidden">: {s.name}</span></a>}
          </li>
        ))}
      </ol>
    </>
  )}

  {droppedStations.length > 0 && (
    <>
      <h3 class="directory__group">On the 2017 plan, dropped in the revised plan</h3>
      <ul class="directory directory--dropped">
        {droppedStations.map((s) => (
          <li class="entry">
            <span class="entry__link">
              <span class="entry__order num" aria-hidden="true"></span>
              <span class="entry__name">{s.name}</span>
            </span>
            {sameSite(s) && <span class="entry__change">Near <LineMark lineId={sameSite(s)!.line} />{sameSite(s)!.href ? <a href={sameSite(s)!.href}>{sameSite(s)!.label}</a> : sameSite(s)!.label}</span>}
            {plan(s) && (
              <span class="entry__change">
                {plan(s)!.value} <Grade status={plan(s)!.status} source={plan(s)!.source_url} compact />
              </span>
            )}
          </li>
        ))}
      </ul>
    </>
  )}
  <p class="directory__source">
    Station list and order <Grade status="reported" source={stationsMeta.order_source_url} />
    <span aria-hidden="true">,</span> station count <Grade status="verified" source={stationsMeta.count_source_url} />
  </p>
</section>

<style>
  .directory {
    columns: 16rem auto;
    column-gap: var(--s-6);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--rule-heavy) solid var(--rule-strong);
  }
  .entry {
    break-inside: avoid;
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-3);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .entry__link {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    min-height: 44px;
    text-decoration: none;
  }
  .entry__order {
    font-size: var(--step--1);
    color: var(--ink-3);
    width: 1.6rem;
    flex: none;
  }
  .entry__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-2);
    line-height: 1;
    text-transform: uppercase;
    position: relative;
    padding-bottom: 0.2em;
  }
  .entry__name::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--bar);
    background: var(--signal-graphic);
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.2s var(--ease-out);
  }
  .entry__link:focus-visible .entry__name::after {
    scale: 1 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .entry__link:hover .entry__name::after {
      scale: 1 1;
    }
  }
  .entry__mr {
    padding-left: calc(1.6rem + var(--s-3));
    font-size: var(--step-0);
    color: var(--ink-2);
  }
  .entry__page {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-left: calc(1.6rem + var(--s-3));
    font-size: var(--step--1);
  }
  .entry__change {
    padding-left: calc(1.6rem + var(--s-3));
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  /* A line in parts: the spur and the dropped stations each under their own heading. */
  .directory__group {
    margin: var(--s-6) 0 var(--s-3);
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
  }
  .directory--dropped .entry__name {
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }
  .directory__source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-4);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
</style>
