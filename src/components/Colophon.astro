---
/** The back of the paper on every page: disclaimer, dates, source code, maintainer, and on a station page the photo credits. */
import { formatDate, lastReviewed as siteReviewed, REPO_URL, photoContributorsFor, type Line } from '../lib/data';

interface Props {
  /** The line this page is about. Off a line page, dates are site-wide. */
  line?: Line;
  /** The station page this footer closes. Photo credits show only on the page whose photos they are. */
  stationId?: string;
}
const { line, stationId } = Astro.props;
const lastReviewed = line?.lastReviewed ?? siteReviewed;
const credits = line && stationId ? photoContributorsFor(line, stationId) : [];
const stationName = line?.stations.find((s) => s.id === stationId)?.name;

// Build date in India time, so it matches the edition date readers see.
const builtAt = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
---

<footer class="colophon">
  <div class="page colophon__inner">
    {credits.length > 0 && (
      <section class="thanks" aria-labelledby="thanks-head">
        <h2 id="thanks-head" class="visually-hidden">Photo credits</h2>
        <ul class="thanks__list">
          {credits.map((c) => (
            <li>
              <p class="thanks__name">{c.credit}</p>
              <p class="thanks__line">
                <a class="thanks__handle" href={`https://x.com/${c.handle}`} rel="noopener" target="_blank">@{c.handle}<span class="visually-hidden"> on X (opens in a new tab)</span></a>
                <span>Ground photos of {stationName} station on this page, shared with permission. Thank you.</span>
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}
    <p class="colophon__disclaimer">
      <strong>Unofficial.</strong> Line 12 Tracker is an independent public-interest site. It is not affiliated with,
      endorsed by or connected to MMRDA or the Government of Maharashtra. Drawings are original illustrations, not
      official designs. Check official sources before making decisions.
    </p>
    <p class="colophon__meta">
      Data last reviewed <time datetime={lastReviewed}>{formatDate(lastReviewed)}</time>
      <span aria-hidden="true">/</span>
      Page built <time datetime={builtAt}>{formatDate(builtAt)}</time>
      <span aria-hidden="true">/</span>
      <a href={REPO_URL} rel="noopener" target="_blank">Source code</a>
    </p>
    <p class="colophon__credit">
      Maintained by{' '}
      <a href="https://x.com/SBallaya" rel="noopener me" target="_blank">@SBallaya<span class="visually-hidden"> on X (opens in a new tab)</span></a>
    </p>
  </div>
</footer>

<style>
  .colophon {
    margin-top: var(--s-8);
    background: var(--paper-2);
    border-top: var(--bar) solid var(--signal);
  }
  .colophon__inner {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-7);
  }
  /* Photo credits: the section-head bar, then the name in display type. */
  .thanks {
    display: grid;
    gap: var(--s-4);
    padding-bottom: var(--s-6);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .thanks::before {
    content: '';
    width: 4.5rem;
    height: var(--bar);
    background: var(--signal-graphic);
  }
  .thanks__list {
    display: grid;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .thanks__list li {
    display: grid;
    gap: var(--s-2);
  }
  .thanks__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-4);
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .thanks__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-4);
    color: var(--ink-2);
  }
  .thanks__handle {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--ink);
  }
  .colophon__disclaimer {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .colophon__credit {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 87.5%;
    font-size: var(--step-1);
  }
  .colophon__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
</style>
