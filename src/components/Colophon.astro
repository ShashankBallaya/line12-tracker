---
/** The back of the paper on every page: photo credits, disclaimer, dates, source code, maintainer. */
import { formatDate, lastReviewed, REPO_URL, photoContributors } from '../lib/data';

// Build date in India time, so it matches the edition date readers see.
const builtAt = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
---

<footer class="colophon">
  <div class="page colophon__inner">
    {photoContributors.length > 0 && (
      <section class="thanks" aria-labelledby="thanks-head">
        <h2 id="thanks-head" class="thanks__kicker">Ground photos by</h2>
        <ul class="thanks__list">
          {photoContributors.map((c) => (
            <li>
              <span class="thanks__name">{c.credit}</span>
              <a class="thanks__handle" href={`https://x.com/${c.handle}`} rel="noopener" target="_blank">@{c.handle}<span class="visually-hidden"> on X (opens in a new tab)</span></a>
              <span class="thanks__what">Photos of {c.stations.join(', ')} {c.stations.length > 1 ? 'stations' : 'station'}, shared with permission. Thank you.</span>
            </li>
          ))}
        </ul>
      </section>
    )}
    <p class="colophon__disclaimer">
      <strong>Unofficial.</strong> Line 12 Tracker is an independent public-interest site. It is not affiliated with,
      endorsed by or connected to MMRDA or the Government of Maharashtra. Drawings are original illustrations, not
      official designs. Check official sources before making decisions.
    </p>
    <p class="colophon__meta">
      Data last reviewed <time datetime={lastReviewed}>{formatDate(lastReviewed)}</time>
      <span aria-hidden="true">/</span>
      Page built <time datetime={builtAt}>{formatDate(builtAt)}</time>
      <span aria-hidden="true">/</span>
      <a href={REPO_URL} rel="noopener" target="_blank">Source code</a>
    </p>
    <p class="colophon__credit">
      Maintained by{' '}
      <a href="https://x.com/SBallaya" rel="noopener me" target="_blank">@SBallaya<span class="visually-hidden"> on X (opens in a new tab)</span></a>
    </p>
  </div>
</footer>

<style>
  .colophon {
    margin-top: var(--s-8);
    background: var(--paper-2);
    border-top: var(--bar) solid var(--signal);
  }
  .colophon__inner {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-7);
  }
  .thanks {
    display: grid;
    padding-left: var(--s-4);
    border-left: var(--bar) solid var(--signal);
    gap: var(--s-3);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--rule);
  }
  .thanks__kicker {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--signal-line);
  }
  .thanks__list {
    display: grid;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .thanks__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-4);
  }
  .thanks__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 87.5%;
    font-size: var(--step-4);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .thanks__handle {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
  }
  .thanks__what {
    flex-basis: 100%;
    color: var(--ink-2);
  }
  .colophon__disclaimer {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .colophon__credit {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 87.5%;
    font-size: var(--step-1);
  }
  .colophon__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
</style>
