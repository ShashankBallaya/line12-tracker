---
import '../styles/global.css';
import anekUrl from '@fontsource-variable/anek-latin/files/anek-latin-latin-standard-normal.woff2?url';
import muktaUrl from '@fontsource/mukta/files/mukta-latin-400-normal.woff2?url';
import { schematic } from '../lib/route';
import { lastReviewed as siteReviewed, lineNodeId, type Line } from '../lib/data';

interface Props {
  title: string;
  description: string;
  /** Page-specific schema.org nodes, added to the site graph (breadcrumbs, stations, FAQ). */
  schema?: Record<string, unknown>[];
  /** The line this page is about. Off a line page (the hub), the graph has no line node. */
  line?: Line;
}

const { title, description, schema = [], line } = Astro.props;
const lastReviewed = line?.lastReviewed ?? siteReviewed;
const pre = line ? schematic(line, { width: 1000, top: 30, drop: 70, pad: 10, bottom: 30 }) : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The route-drawing preloader belongs to the front page; inside pages open straight on their answer.
const front = Astro.url.pathname === '/';
const siteUrl = Astro.site!.toString();
// One graph per page: the site, the page, what it is about, then the page's own nodes.
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#site`,
      // Google reads the site name from here on the home page (a pages.dev subdomain otherwise shows as "Cloudflare").
      name: 'Line 12 Tracker',
      alternateName: ['Line 12 Tracker, Mumbai Metro', 'Metro Line 12 Tracker'],
      url: siteUrl,
      inLanguage: 'en-IN',
      publisher: { '@id': `${siteUrl}#maintainer` },
    },
    { '@type': 'Person', '@id': `${siteUrl}#maintainer`, name: 'Shashank Ballaya', url: 'https://x.com/SBallaya' },
    ...(line
      ? [
          {
            '@type': 'Thing',
            '@id': lineNodeId(siteUrl, line),
            name: line.info.about.name,
            alternateName: line.info.about.alternate_names,
            description: line.info.about.description,
            sameAs: line.info.about.same_as,
          },
        ]
      : []),
    {
      '@type': 'WebPage',
      '@id': `${canonical}#page`,
      url: canonical.toString(),
      name: title,
      description,
      inLanguage: 'en-IN',
      isPartOf: { '@id': `${siteUrl}#site` },
      ...(line ? { about: { '@id': lineNodeId(siteUrl, line) } } : {}),
      dateModified: lastReviewed,
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0c1422" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#efe9de" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- PNG icons for search results (a multiple of 48 px) and phone home screens. -->
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={anekUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={muktaUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Line 12 Tracker: Watch Mumbai Metro Line 12 rise, pillar by pillar. Kalyan to Taloja, 23.57 km, 19 stations." />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Line 12 Tracker" />
    <meta name="application-name" content="Line 12 Tracker" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@SBallaya" />
    <meta name="author" content="Shashank Ballaya" />
    <meta name="google-site-verification" content="xNfPqkQYtCv9oIrSBO6GExNvIcLZ1IEr-tKf0H0zeUg" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>
      // Apply a saved theme before first paint. Storage can be blocked; the system theme is the fallback.
      try {
        var t = localStorage.getItem('l12-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        // The route-drawing preloader plays once per visit.
        if (sessionStorage.getItem('l12-seen')) document.documentElement.classList.add('seen');
        else sessionStorage.setItem('l12-seen', '1');
      } catch (e) {}
    </script>
  </head>
  <body>
    {front && pre && (
      <div class="preloader" aria-hidden="true">
        <svg viewBox={`0 0 ${pre.width} ${pre.height}`} preserveAspectRatio="xMidYMid meet">
          <path d={pre.path} pathLength="1" class="preloader__casing" />
          <path d={pre.path} pathLength="1" class="preloader__core" />
        </svg>
      </div>
    )}
    <a class="skip-link" href="#main">Skip to the paper</a>
    <slot />
    <script>
      import '../scripts/motion';
      import '../scripts/theme';
      import '../scripts/countdown';
      import '../scripts/scenes';
      import '../scripts/pointer';
    </script>
  </body>
</html>
